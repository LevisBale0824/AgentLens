<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agentlens</groupId>
        <artifactId>agentlens</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>agentlens-cli</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.agentlens</groupId>
            <artifactId>agentlens-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agentlens</groupId>
            <artifactId>agentlens-adapters</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agentlens</groupId>
            <artifactId>agentlens-eval</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.agentlens.cli.AgentLensApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
