<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for AgentLens. Each entry is a proven false positive,
  scoped to a single class + bug type.

  - ExperimentRunner EI_EXPOSE_REP2: the runner's JsonlRunStore constructor
    parameter is a dependency-injected collaborator, not internal state.
    ExperimentRunner must write run summaries into the caller's store, so a
    defensive copy is impossible (JsonlRunStore wraps a live file) and would
    change behavior. The field is private and never returned to callers.

  - ApprovedBaseline$Baseline EI_EXPOSE_REP: the record's collection components
    (evaluatorNames, casePassRates) are defensively copied in the compact
    constructor via List.copyOf / Map.copyOf, so the accessors return immutable
    collections. SpotBugs 4.8.3 does not track the copies through this nested
    record's canonical constructor (the identical pattern in CorpusLoader
    passes) - detector limitation, not an exposed representation.

  - ScoreRecord EI_EXPOSE_REP: same family as ApprovedBaseline$Baseline - the
    caseOutcomes map is defensively copied in the compact constructor (fresh
    TreeMap + List.copyOf per value), so accessors hand out unmodifiable data.
    SpotBugs does not track the copies through the Collectors.toMap pipeline.

  - SuccessAssertions$Assertion / $Result EI_EXPOSE_REP: same nested-record
    family as ApprovedBaseline$Baseline. alternatives / outcomes are built via
    List.copyOf at every construction site in SuccessAssertions (parse,
    evaluate), so accessors return immutable data; the detector does not track
    copies through nested record canonical constructors.
-->
<FindBugsFilter>
  <Match>
    <Class name="com.agentlens.eval.ExperimentRunner"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.agentlens.eval.ApprovedBaseline$Baseline"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.agentlens.eval.ScoreRecord"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.agentlens.eval.SuccessAssertions$Assertion"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.agentlens.eval.SuccessAssertions$Result"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
